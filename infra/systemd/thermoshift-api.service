[Unit]
Description=ThermoShift API (프론트용 데이터·제어 API)
# PostgreSQL 이 먼저 떠 있어야 커넥션 풀이 열린다. Docker 로 띄운다면
# After=docker.service 로 바꿀 것.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=thermo
WorkingDirectory=/home/thermo/ThermoShift-hanium
Environment="DB_HOST=localhost"
Environment="DB_PORT=5432"
Environment="DB_USER=thermoshift"
Environment="DB_NAME=thermoshift"
# 비밀번호는 저장소에 두지 않는다. 아래 파일에 DB_PASSWORD=... 한 줄.
#   sudo install -o thermo -g thermo -m 600 /dev/null /etc/thermoshift.env
EnvironmentFile=-/etc/thermoshift.env
# AI 기능을 켜려면 같은 파일에 ANTHROPIC_API_KEY=sk-ant-... 를 넣는다.
# 키는 반드시 서버에만 둔다 — 프론트는 브라우저에서 돌기 때문에
# 거기 넣으면 그대로 노출된다.
ExecStart=/home/thermo/ThermoShift-hanium/.venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
