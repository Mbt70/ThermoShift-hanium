# PostgreSQL 접속 정보 (api/db.py 가 읽음)
# 로컬 docker-compose(infra/docker-compose.yml) 기본값과 동일 - 그대로 둬도 로컬 개발엔 문제없음.
#
# DB_HOST: 로컬 개발은 localhost. EC2 배포(infra/docker-compose.ec2.yml)에서는
#   api 컨테이너가 postgres 컨테이너를 서비스명으로 찾으므로 반드시 postgres 로 바꿀 것
#   (localhost 로 두면 api 컨테이너 자기 자신을 찾다가 접속 실패한다).
DB_HOST=localhost
DB_PORT=5432
DB_USER=thermoshift
# DB_PASSWORD: 서버(EC2 등)에 배포할 때는 반드시 새로 생성해서 쓸 것.
#   openssl rand -base64 24
#   아래 thermoshift1234 는 이 저장소가 public 이라 이미 노출된 값이므로
#   로컬 개발 전용이다 — 서버에서 그대로 쓰지 말 것.
DB_PASSWORD=thermoshift1234
DB_NAME=thermoshift

# 웹/앱이 API를 호출할 때 쓰는 베이스 URL (shared/api_client.py 가 읽음)
# Windows에서 "localhost"는 DNS 해석이 느려서(초당 수 초) 127.0.0.1을 기본값으로 씀.
# 배포 후에는 실제로 인터넷/사설망에서 접근 가능한 공개 주소로 교체해야 한다
# (예: Tailscale 고정 주소 https://<호스트>.<테일넷>.ts.net/api).
THERMOSHIFT_API_URL=http://127.0.0.1:8000

# AI 해설·리포트 기능 (api/services/ai.py)에 필요. 없으면 이 기능만 꺼진 채로
# 나머지 시스템은 정상 동작함 (api/routers/ai.py가 503으로 우아하게 처리).
GEMINI_API_KEY=
